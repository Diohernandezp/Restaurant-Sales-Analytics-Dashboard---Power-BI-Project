{
  "name": "Restaurant Green Corporate Theme",
  "dataColors": [
    "#1B5E20",
    "#2E7D32",
    "#388E3C",
    "#43A047",
    "#4CAF50",
    "#66BB6A",
    "#81C784",
    "#A5D6A7",
    "#C8E6C9",
    "#E8F5E9"
  ],
  "background": "#F5F7F5",
  "foreground": "#1B3A1B",
  "tableAccent": "#2E7D32",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1B3A1B"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#1B3A1B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4A6B4A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#4A6B4A" } },
            "fontSize": 12
          }
        ],
        "values": [
          {
            "color": { "solid": { "color": "#1B3A1B" } },
            "fontSize": 36,
            "fontWeight": "bold"
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E8F0E8" } },
            "axisLineColor": { "solid": { "color": "#C8DCC8" } },
            "labelColor": { "solid": { "color": "#4A6B4A" } }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E8F0E8" } },
            "axisLineColor": { "solid": { "color": "#C8DCC8" } },
            "labelColor": { "solid": { "color": "#4A6B4A" } }
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backgroundColor": { "solid": { "color": "#1B5E20" } },
            "fontWeight": "bold"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#1B3A1B" } }
          }
        ],
        "grid": [
          {
            "gridColor": { "solid": { "color": "#E8F0E8" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontSize": 13,
            "fontColor": { "solid": { "color": "#1B3A1B" } }
          }
        ],
        "header": [
          {
            "fontSize": 14,
            "fontColor": { "solid": { "color": "#1B3A1B" } },
            "fontWeight": "bold"
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#F5F7F5" } }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E8F0E8" } },
            "labelColor": { "solid": { "color": "#4A6B4A" } }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E8F0E8" } },
            "labelColor": { "solid": { "color": "#4A6B4A" } }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E8F0E8" } },
            "labelColor": { "solid": { "color": "#4A6B4A" } }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E8F0E8" } },
            "labelColor": { "solid": { "color": "#4A6B4A" } }
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#1B3A1B" } }
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [
          {
            "backgroundColor": { "solid": { "color": "#FFFFFF" } },
            "borderRadius": 8
          }
        ],
        "labels": [
          {
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#4A6B4A" } }
          }
        ],
        "values": [
          {
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#1B3A1B" } },
            "fontWeight": "bold"
          }
        ]
      }
    }
  }
}